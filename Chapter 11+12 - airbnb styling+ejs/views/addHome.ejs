
<%- include('partials/head')%>
<body class="bg-gray-100 min-h-screen">

  <!-- Header -->
  <%- include('partials/nav')%>

  <!-- Main Content -->
  <main class="flex justify-center pt-16 px-6">
    <div class="bg-white w-full max-w-3xl rounded-md shadow-lg px-10 py-10">

      <h1 class="text-4xl font-bold text-gray-900 text-center mb-8">
        Register Your Home on AirBnB
      </h1>

      <form action="/host/add-home" method="POST" class="space-y-5">

        <input
          type="text"
          name="houseName"
          placeholder="Enter the name of your house"
          class="w-full px-4 py-3 border-2 border-red-400 rounded-md focus:outline-none focus:ring-2 focus:ring-red-300 focus:border-red-500 transition"
        />
        <br>
        <br>
        <button
          type="submit"
          class="w-full bg-red-500 hover:bg-red-600 text-white font-semibold py-3 rounded-md transition"
        >
          Submit
        </button>

      </form>

    </div>
  </main>

</body>
</html>