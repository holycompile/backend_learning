<%- include('../partials/head') %>

  <body class="bg-gray-100 min-h-screen">

<%- include('../partials/nav') %>

    <main class="flex justify-center pt-10 px-4">
    <div class="w-full max-w-3xl">
      <h1 class="text-3xl font-bold text-red-500 text-center mb-8">
        Here are our Favourite homes:
      </h1>
      <!--Here now we are using the concept of EJS (embedded javascript)
          for flow control : <%  %>
          for output: <%= %> -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

          <% registeredHomes.forEach(home => { %>
            <div class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300">
              <!-- Photo -->
              <img
                src="<%= home.photoURL || 'https://placehold.co/600x400?text=No+Image' %>"
                alt="<%= home.houseName %>"
                class="w-full h-48 object-cover"
                onerror="this.onerror=null; this.src='https://placehold.co/600x400?text=No+Image';"
              />

              <!-- Card Body -->
              <div class="p-5 space-y-2">
                <h2 class="text-xl font-semibold text-gray-900"><%= home.houseName %></h2>

                <p class="text-sm text-gray-500 flex items-center gap-1">
                  📍 <%= home.location %>
                </p>

                <div class="flex items-center justify-between">
                  <span class="text-lg font-bold text-green-600">₹ <%= home.price %></span>
                  <span class="text-yellow-500 text-sm font-medium">
                    ⭐ <%= home.rating %> / 5
                  </span>
                </div>
              </div>
              <button class="w-full py-3 bg-gradient-to-r from-green-500 to-emerald-600 text-white font-semibold tracking-wide rounded-b-2xl hover:from-green-600 hover:to-emerald-700 hover:shadow-lg active:scale-[0.98] transition-all duration-200 cursor-pointer">
                Book Now
              </button>
            </div>
            
          <% }); %>

      </div>
    </div>
  </main>
  </body>
</html>

