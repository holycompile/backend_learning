<%- include('../partials/head') %>

  <body class="bg-gray-100 min-h-screen">

<%- include('../partials/nav') %>

    <main class="flex justify-center pt-10 px-4">
    <div class="w-full max-w-3xl">
      <h1 class="text-3xl font-bold text-red-500 text-center mb-8">
        Here are our registered homes:
      </h1>
      <!--Here now we are using the concept of EJS (embedded javascript)
          for flow control : <%  %>
          for output: <%= %> -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

          <% registeredHomes.forEach(home => { %>
            <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-shadow duration-300 p-3 pb-5">
              <!-- Photo -->
              <img
                src="<%= home.photoURL || 'https://placehold.co/600x400?text=No+Image' %>"
                alt="<%= home.houseName %>"
                class="w-full h-48 object-cover rounded-xl"
                onerror="this.onerror=null; this.src='https://placehold.co/600x400?text=No+Image';"
              />

              <!-- Card Body -->
              <div class="pt-4 px-1 space-y-1">
                <h2 class="text-lg font-bold text-gray-900"><%= home.houseName %></h2>
                <p class="text-sm text-gray-500"><%= home.location %></p>

                <div class="flex items-center justify-between pt-2">
                  <span class="text-base font-bold text-red-500">Rs<%= home.price %> / night</span>
                  <span class="text-sm font-medium">
                    ⭐ <%= home.rating %>
                  </span>
                </div>

                <!-- Action Buttons -->
                <div class="flex gap-2 pt-3">
                  <a href="/homes/<%= home.id %>" class="px-4 py-1.5 bg-teal-500 text-white text-sm font-semibold rounded hover:bg-teal-600 transition-colors duration-200">Details</a>
                  <button class="px-4 py-1.5 bg-yellow-400 text-gray-900 text-sm font-semibold rounded hover:bg-yellow-500 transition-colors duration-200 cursor-pointer">Book</button>
                </div>
              </div>
            </div>
            
          <% }); %>

      </div>
    </div>
  </main>
  </body>
</html>

